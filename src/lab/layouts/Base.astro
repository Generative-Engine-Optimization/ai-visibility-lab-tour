---
/* Struttura comune a tutte le pagine: testa con SEO e dati strutturati, testata, contenuto, footer. */
import "../styles/tour.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { SITO, TAPPE, ALIAS, oggiRoma } from "../lib/tour.js";
import { grafo } from "../lib/seo.js";
import { ANTEPRIMA } from "../lib/url.js";

const {
  titolo,             /* <title>, massimo ~60 caratteri */
  descrizione,        /* meta description, ~150 caratteri */
  path,               /* percorso della pagina sul sito vero, es. "/tappe/pistoia/" */
  immagine = "/og/tour.png",
  noindex = false,
  jsonld = [],
  attuale = "",
  home = false
} = Astro.props;

const canonico = SITO + path;
const og = SITO + immagine;
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const idTappe = TAPPE.map((t) => t.id);
/* Google Tag Manager: il contenitore del sito. Gli strumenti di statistica e marketing vanno configurati lì
   e partono solo dopo il consenso (Consent Mode v2: vedi lo script qui sotto e src/lab/scripts/consenso.js). */
const GTM_ID = "GTM-PPVD9VLM";
---
<!doctype html>
<html lang="it" data-base={base} data-oggi={oggiRoma()}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<script is:inline>document.documentElement.classList.add("js")</script>
<title>{titolo}</title>
<meta name="description" content={descrizione}>
<link rel="canonical" href={canonico}>
{(noindex || ANTEPRIMA) && <meta name="robots" content="noindex, follow">}
<meta name="color-scheme" content="light only">
<meta name="theme-color" content="#1B0B3A">
<link rel="icon" href={base + "/assets/rankwit-symbol.png"}>
{!ANTEPRIMA && <link rel="sitemap" href="/sitemap-index.xml">}
<meta property="og:type" content="website">
<meta property="og:locale" content="it_IT">
<meta property="og:site_name" content="AI Visibility Lab · RankWit AI">
<meta property="og:title" content={titolo}>
<meta property="og:description" content={descrizione}>
<meta property="og:url" content={canonico}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={titolo}>
<meta name="twitter:description" content={descrizione}>
<meta name="twitter:image" content={og}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,400..800;1,400..800&family=Inter:wght@400;500;600&display=swap">
{jsonld.length > 0 && <script type="application/ld+json" is:inline set:html={grafo(jsonld)} />}
{home && (
  /* vecchi link della pagina unica (#pistoia, #hotel...): portano alle pagine nuove */
  <script is:inline define:vars={{ base, idTappe, ALIAS }}>
    (function(){
      var h = location.hash.slice(1); if (!h) return;
      if (h === "hotel" || h === "destinations"){ location.replace(base + "/" + h + "/" + location.search); return; }
      var id = ALIAS[h] || h;
      if (idTappe.indexOf(id) >= 0) location.replace(base + "/tappe/" + id + "/" + location.search);
    })();
  </script>
)}
{/* Consenso (Google Consent Mode v2): tutto negato finché il visitatore non sceglie dal banner.
    Una scelta già fatta (memoria locale "rw-consenso", valida 6 mesi) viene riapplicata prima che parta Tag Manager. */}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted', wait_for_update: 500 });
  (function(){
    try {
      var c = JSON.parse(localStorage.getItem('rw-consenso'));
      if (!c || !c.data || Date.now() - Date.parse(c.data) > 180 * 864e5) return;
      gtag('consent', 'update', { analytics_storage: c.statistiche ? 'granted' : 'denied', ad_storage: c.marketing ? 'granted' : 'denied', ad_user_data: c.marketing ? 'granted' : 'denied', ad_personalization: c.marketing ? 'granted' : 'denied' });
      dataLayer.push({ event: 'consenso', consenso_statistiche: !!c.statistiche, consenso_marketing: !!c.marketing });
    } catch(e){}
  })();
  gtag('js', new Date());
</script>
{!ANTEPRIMA && (
  /* Google Tag Manager. Non si carica nell'anteprima su GitHub Pages. */
  <script async src={`https://www.googletagmanager.com/gtm.js?id=${GTM_ID}`}></script>
)}
</head>
<body>
<Header attuale={attuale} />
<slot />
<Footer />
<CookieBanner />
<script>
  import "../scripts/tour.js";
</script>
</body>
</html>
